<Window x:Class="ExcelDropViewer.DigikeyConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digikey API 설정"
        Width="450"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="CLIENT_ID" />
        <TextBox x:Name="ClientIdTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 Padding="6,4"
                 TextChanged="Input_TextChanged" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="CLIENT_SECRET" />
        <PasswordBox x:Name="ClientSecretPasswordBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     Padding="6,4"
                     PasswordChanged="Input_PasswordChanged" />

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,8"
                   Foreground="#2563EB"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="OkButton"
                    Width="80"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Click="OkButton_Click"
                    Content="확인"
                    IsDefault="True" />
            <Button x:Name="ApplyButton"
                    Width="80"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Click="ApplyButton_Click"
                    Content="적용"
                    IsEnabled="False" />
            <Button x:Name="CancelButton"
                    Width="80"
                    Padding="8,4"
                    Click="CancelButton_Click"
                    Content="취소"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
